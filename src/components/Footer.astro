---
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="Watermark Studio" class="w-6 h-6 rounded" />
        <span class="text-sm text-text-secondary">
          &copy; {year} Watermark Studio. Open source under the
          <a
            href="https://github.com/Devdre1909/watermark-studio/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-light hover:underline"
          >
            GPL-3.0 License
          </a>.
        </span>
      </div>

      <div class="flex items-center gap-6">
        <a
          href="https://github.com/Devdre1909/watermark-studio"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-text-primary transition-colors text-sm"
        >
          GitHub
        </a>
        <a
          href="https://github.com/Devdre1909/watermark-studio/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-text-primary transition-colors text-sm"
        >
          Releases
        </a>
      </div>
    </div>
  </div>
</footer>
