---

---

<section class="relative pt-32 pb-20 overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(99,102,241,0.08),transparent_60%)]"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-6 text-center">
    <div class="animate-fade-in-up">
      <span
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-sm text-primary-light mb-8"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary-light animate-pulse"
        ></span>
        v0.2.0 — Now with AI-powered placement
      </span>
    </div>

    <h1
      class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] animate-fade-in-up-delay-1"
    >
      Watermark your images
      <br />
      <span class="gradient-text">with precision</span>
    </h1>

    <p
      class="mt-6 text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed animate-fade-in-up-delay-2"
    >
      A fast, desktop-native tool for batch watermarking with AI-assisted
      placement, real-time preview, and a preset system. Built for
      photographers, designers, and content creators.
    </p>

    <div
      class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up-delay-3"
    >
      <a
        href="#download"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-primary/25 active:scale-[0.98]"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        Download Free
      </a>
      <a
        href="https://github.com/Devdre1909/watermark-studio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl border border-border hover:border-primary/40 text-text-primary font-semibold text-base transition-all hover:bg-surface-hover active:scale-[0.98]"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"></path>
        </svg>
        View on GitHub
      </a>
    </div>

    <div class="mt-16 relative animate-fade-in-up-delay-3">
      <div class="glow rounded-2xl">
        <div
          class="rounded-2xl border border-border overflow-hidden bg-surface-elevated"
        >
          <img
            src="/screenshot.png"
            alt="Watermark Studio — Desktop watermarking app with AI-powered placement"
            class="w-full block"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
